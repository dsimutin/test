# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Google Spreadsheet ID (from the URL: docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Path to Google service account JSON credentials file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Name of the sheet tab with vocabulary (default: vocabulary)
SHEET_NAME=vocabulary
