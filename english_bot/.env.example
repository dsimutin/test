# Telegram bot token (from @BotFather)
BOT_TOKEN=123456:ABCDEF

# Google Sheets
# Either path to service-account JSON file:
GOOGLE_CREDENTIALS_FILE=./credentials.json
# Or paste the JSON directly (Railway-friendly):
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Spreadsheet ID (the long token in the Google Sheets URL)
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUv

# SQLite database file
DB_PATH=./data/english_bot.db

# Cache dir for rendered card PNGs
CARD_CACHE_DIR=./data/cache

# Teacher access — by Telegram ID or @username (comma-separated).
# At least one of TEACHER_IDS / TEACHER_USERNAMES should be set.
# Teachers get the extended menu (Students, Sync, CSV export).
# Узнать свой ID: напиши боту /myid
TEACHER_IDS=123456789
TEACHER_USERNAMES=mrgrief
